{
  "name": "lutece-chat-client",
  "version": "2.0.0",
  "description": "Lutece AI chat widget — vanilla Custom Element (lutece-chat)",
  "type": "module",
  "main": "./webapp/js/lutecechat/dist/lutece-chat-bundle.js",
  "module": "./webapp/js/lutecechat/dist/lutece-chat-bundle.js",
  "exports": {
    ".": "./webapp/js/lutecechat/dist/lutece-chat-bundle.js"
  },
  "sideEffects": [
    "./src/index.js",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "manifest": "custom-elements-manifest analyze --globs \"src/**/*.js\""
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.60.0",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "customElements": "custom-elements.json"
}
